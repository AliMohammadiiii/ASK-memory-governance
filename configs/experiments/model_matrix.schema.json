{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "paid_inference_authorized", "shared_controls", "systems"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"type": "string"},
    "paid_inference_authorized": {"type": "boolean"},
    "shared_controls": {
      "type": "object",
      "required": ["temperature", "seeds", "retry_policy", "concurrency", "response_schema", "prompt_version", "adapter_version", "context_settings"]
    },
    "systems": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["system_id", "family", "exact_model_id", "provider", "model_snapshot", "policy", "run_authorization", "status", "estimated_calls", "estimated_tokens", "estimated_cost", "observed_cost", "artifact_hashes"],
        "properties": {
          "system_id": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "exact_model_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model_snapshot": {"type": "string", "minLength": 1},
          "policy": {"enum": ["model_only", "rule_only", "zero_shot", "ask_mgp_composed", "ask_lme_scorecard"]},
          "run_authorization": {"type": "string"},
          "status": {"enum": ["not_run", "dry_run_passed", "completed", "failed"]},
          "estimated_calls": {"type": ["integer", "null"], "minimum": 0},
          "estimated_tokens": {"type": ["integer", "null"], "minimum": 0},
          "estimated_cost": {"type": ["number", "null"], "minimum": 0},
          "observed_cost": {"type": ["number", "null"], "minimum": 0},
          "artifact_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
