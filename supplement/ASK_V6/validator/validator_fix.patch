+def test_canonical_serialization_is_sorted_compact_utf8() -> None:
+    value = {"b": [1, 2.5, None, True], "a": {"z": "é", "y": "x y"}}
+    expected = '{"a":{"y":"x y","z":"é"},"b":[1,2.5,null,true]}'.encode()
