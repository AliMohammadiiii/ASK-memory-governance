+def test_known_limit_event_metadata_is_not_part_of_the_event_identifier() -> None:
+    base = _supersede()
+    annotated = base._replace(event=replace(base.event, metadata={"note": "unbound"}))
+    assert _validate(annotated).unverified == ()
