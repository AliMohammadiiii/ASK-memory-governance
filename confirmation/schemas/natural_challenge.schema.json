{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.example/schemas/natural-challenge-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blind_id",
    "task_version",
    "source_class",
    "consent_basis",
    "redaction_record",
    "predecessor",
    "candidate",
    "context"
  ],
  "properties": {
    "blind_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "task_version": {"const": "mgpn-natural-annotation/0.1.1-derived"},
    "source_class": {"enum": ["consented_interaction", "public_document", "expert_authored"]},
    "consent_basis": {"type": "string", "minLength": 1},
    "redaction_record": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_slot", "principal", "scope", "standing_value", "status"],
      "properties": {
        "memory_slot": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "standing_value": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "text"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue", "evaluation_query", "construction_notice"],
      "properties": {
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn_id", "speaker", "text"],
            "properties": {
              "turn_id": {"type": "string", "minLength": 1},
              "speaker": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "evaluation_query": {"type": "string", "minLength": 1},
        "construction_notice": {"type": "string", "minLength": 1}
      }
    }
  }
}
