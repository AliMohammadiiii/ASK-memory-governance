{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dialogue": {
      "type": "array"
    },
    "evaluation_query": {
      "type": "string"
    },
    "gold_action": {
      "enum": [
        "KEEP",
        "SUPERSEDE",
        "ABSTAIN"
      ]
    },
    "memory_before": {
      "type": "object"
    },
    "public_id": {
      "pattern": "^MGP43-[0-9A-F]{20}$",
      "type": "string"
    }
  },
  "required": [
    "public_id",
    "memory_before",
    "dialogue",
    "evaluation_query",
    "gold_action"
  ],
  "type": "object"
}
