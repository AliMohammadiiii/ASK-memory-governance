FROM python:3.12.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /work
COPY . /work
RUN python -m pip install --no-cache-dir \
    --constraint constraints/repro-py312.txt \
    -e '.[dev]'
CMD ["make", "reproduce-public", "PYTHON=python"]

