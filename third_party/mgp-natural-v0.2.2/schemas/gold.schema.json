{
  "$id": "https://example.org/mgp-natural/gold.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "KEEP",
        "SUPERSEDE",
        "ABSTAIN"
      ]
    },
    "annotation_status": {
      "const": "independently_adjudicated_gold"
    },
    "blind_id": {
      "type": "string"
    },
    "evidence_turn_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "resulting_value": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "enum": [
        "SESSION_TASK_STATE",
        "CROSS_SESSION_TASK_STATE",
        "SESSION_INTERACTION_PREFERENCE",
        "CROSS_SESSION_USER_PREFERENCE",
        "ARTIFACT_STATE",
        "CORRECTION_STATE",
        "UNCERTAINTY_STATE",
        "EDITORIAL_DECISION",
        "CONTENT_INCLUSION",
        "CONTENT_REMOVAL",
        "WORDING_STATE",
        "SOURCE_STATUS",
        "CONSENSUS_STATE",
        "DISPUTE_STATE",
        "REVISION_STATE",
        "DELETION_RESTORATION",
        "EDITORIAL_UNCERTAINTY"
      ]
    },
    "source_track": {
      "enum": [
        "STUDYCHAT",
        "WIKICONV"
      ]
    }
  },
  "required": [
    "schema_version",
    "blind_id",
    "source_track",
    "scope",
    "action",
    "evidence_turn_ids",
    "resulting_value",
    "annotation_status"
  ],
  "type": "object"
}

