{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mgp-natural/ai_annotation.schema.json",
  "title": "MGP-Natural AI-provisional annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "blind_id", "ai_tag",
    "annotation_status", "annotator_type", "annotator_id", "model_family",
    "reasoning_mode", "prompt_version", "prompt_sha256", "run_id",
    "generated_at_utc", "human_verified", "requires_human_review",
    "pass_seed", "item_sha256", "exclude", "exclusion_reason", "action",
    "confidence", "evidence_turn_ids", "resulting_value", "rationale",
    "ambiguity_category", "lineage_relation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_version": {"type": "string", "minLength": 1},
    "blind_id": {"type": "string", "minLength": 1},
    "ai_tag": {"const": "AI"},
    "annotation_status": {"const": "AI_PROVISIONAL_NOT_GOLD"},
    "annotator_type": {"const": "AI"},
    "annotator_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "reasoning_mode": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "human_verified": {"const": false},
    "requires_human_review": {"const": true},
    "pass_seed": {"type": "integer"},
    "item_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exclude": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "action": {"enum": ["KEEP", "SUPERSEDE", "ABSTAIN", null]},
    "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
    "evidence_turn_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resulting_value": {"type": ["string", "null"]},
    "rationale": {"type": "string", "minLength": 1},
    "ambiguity_category": {"type": ["string", "null"]},
    "lineage_relation": {"type": ["string", "null"]}
  }
}

