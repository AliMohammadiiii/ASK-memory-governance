{
  "$id": "https://example.org/mgp-natural/annotation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "exclude": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "type": "null"
          },
          "exclusion_reason": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exclude": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "enum": [
              "KEEP",
              "SUPERSEDE",
              "ABSTAIN"
            ]
          },
          "confidence": {
            "type": "integer"
          },
          "evidence_turn_ids": {
            "minItems": 1
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "KEEP",
        "SUPERSEDE",
        "ABSTAIN",
        null
      ]
    },
    "ambiguity_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "annotator_pseudonym": {
      "minLength": 1,
      "type": "string"
    },
    "blind_id": {
      "type": "string"
    },
    "confidence": {
      "maximum": 5,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "evidence_turn_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "exclude": {
      "type": "boolean"
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "manual_version": {
      "const": "1.0-prospective"
    },
    "protocol_version": {
      "const": "1.0-prospective"
    },
    "rationale": {
      "type": "string"
    },
    "resulting_value": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "manual_version",
    "protocol_version",
    "blind_id",
    "annotator_pseudonym",
    "exclude",
    "exclusion_reason",
    "action",
    "confidence",
    "evidence_turn_ids",
    "resulting_value",
    "rationale",
    "ambiguity_category"
  ],
  "title": "Independent MGP annotation",
  "type": "object"
}

